# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Authentication
JWT_SECRET=your-secret-key

# File Upload
UPLOAD_DIR=./uploads

# Backup Configuration (S3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
BACKUP_S3_BUCKET=your-bucket-name
BACKUP_S3_PREFIX=inventory-backups
VOLUME_PATH=/app/public/uploads/products
RETENTION_DAYS=30

# Email Alerts (SMTP) — optional, for low-stock notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=alerts@adstation.com
ALERT_RECIPIENT_EMAILS=admin@adstation.com,manager@adstation.com

# Error Monitoring (Sentry) — optional
SENTRY_DSN=

# Rate Limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Permissions — Emergency owner bypass (disabled by default, DO NOT enable in production)
# PERMISSION_EMERGENCY_BYPASS=false
