{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx prisma generate --force && ./node_modules/.bin/tsc"
  },
  "deploy": {
    "startCommand": "npx prisma db push --skip-generate && node dist/seed-import.js && node dist/index.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
